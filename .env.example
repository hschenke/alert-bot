# ============================================================================
# Alert-Bot – Lokale Umgebungsvariablen (Vorlage)
# Kopieren nach `.env` und echte Werte eintragen (NIEMALS `.env` committen!)
# ============================================================================

# 1. Google Gemini API (für Freitext-Assistent, Web-Suche & KI-Auswertung)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL=gemini-3.8-flash

# 2. Cloud-Persistenz via Turso LibSQL (leer lassen = lokales SQLite unter data/alert_bot.db)
TURSO_URL=
TURSO_KEY=

# 3. E-Mail-Benachrichtigung (resend oder smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_TO=your_email@example.com
EMAIL_FROM=Alert Bot <onboarding@resend.dev>

# Optionaler SMTP-Fallback (wenn EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 4. Hintergrund-Worker via GitHub Actions (optional für Sofort-Checks aus Streamlit Cloud)
WORKER_MODE=auto
GITHUB_REPO=hschenke/alert-bot
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=check_alerts.yaml
GITHUB_TOKEN=

# 5. Web-App Zugriffsschutz & signierte E-Mail-Direktlinks
APP_PASSWORD=
STREAMLIT_APP_URL=
