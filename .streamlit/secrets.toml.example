# Streamlit Community Cloud -> App Settings -> Secrets (TOML-Format)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_DEEP_MODEL = "gemini-3.8-flash"

# Cloud-Persistenz (Turso LibSQL) – teilt Regeln & Treffer mit GitHub Actions
TURSO_URL = "libsql://deine-datenbank-user.turso.io"
TURSO_KEY = "your_turso_auth_token"

# E-Mail-Alarmierung (Resend empfohlen: 3.000 Mails/Monat kostenlos)
EMAIL_PROVIDER = "resend"
RESEND_API_KEY = "your_resend_api_key"
EMAIL_TO = "deine-adresse@example.com"
EMAIL_FROM = "Alert Bot <onboarding@resend.dev>"

# Zugriffsschutz & signierte Smartphone-Links in Alarm-Mails
APP_PASSWORD = "ein-sicheres-passwort"
STREAMLIT_APP_URL = "https://dein-alert-bot.streamlit.app"

# Optional: Fine-Grained GitHub Token (Actions: Read & Write) für "Jetzt in Cloud prüfen"
GITHUB_REPO = "hschenke/alert-bot"
GITHUB_TOKEN = "your_github_fine_grained_pat"
